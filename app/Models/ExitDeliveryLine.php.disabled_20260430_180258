<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

class ExitDeliveryLine extends Model
{
    protected $fillable = [
        'exit_delivery_id',
        'exit_inventory_item_id',
        'product_id',
        'product_variant_id',
        'quantity',
        'unit_cost',
        'stock_movement_line_id',
    ];

    protected $casts = [
        'quantity' => 'decimal:6',
        'unit_cost' => 'decimal:6',
    ];
}
