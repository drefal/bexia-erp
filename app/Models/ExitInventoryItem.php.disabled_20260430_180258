<?php

namespace App\Models;

use App\Models\Company;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Model;

class ExitInventoryItem extends Model
{
    protected $fillable = [
        'form_submission_id',
        'company_id',
        'item_index',
        'folio',
        'item_description',
        'requested_quantity',
        'delivered_quantity',
        'product_id',
        'product_variant_id',
        'warehouse_id',
        'source_location_id',
        'destination_location_id',
        'source_warehouse_label',
        'destination_warehouse_label',
        'project_label',
        'delivery_status',
        'raw_item',
    ];

    protected $casts = [
        'requested_quantity' => 'decimal:6',
        'delivered_quantity' => 'decimal:6',
        'raw_item' => 'array',
    ];

    public function getPendingQuantityAttribute(): float
    {
        return max(0, (float) $this->requested_quantity - (float) $this->delivered_quantity);
    }

    public function getIsMappedAttribute(): bool
    {
        return (int) ($this->product_id ?? 0) > 0;
    }
    public function company(): BelongsTo
    {
        return $this->belongsTo(Company::class);
    }


}
